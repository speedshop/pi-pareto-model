{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/speedshop/pi-pareto-model/main/schema/model-metrics-catalog.schema.json",
  "title": "Model Metrics Catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalog", "variants"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "generatedAt", "sourceUpdatedAt", "distribution", "metricDefinitions", "provenance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "sourceUpdatedAt": { "type": ["string", "null"], "format": "date-time" },
        "distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "termsUrl", "attribution", "allowRedistribution"],
          "properties": {
            "classification": { "enum": ["restricted", "redistributable"] },
            "termsUrl": { "type": ["string", "null"], "format": "uri" },
            "attribution": { "type": ["string", "null"] },
            "allowRedistribution": { "type": "boolean" }
          }
        },
        "metricDefinitions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["smart", "fast", "cheap"],
          "properties": {
            "smart": { "$ref": "#/definitions/higher" },
            "fast": { "$ref": "#/definitions/lower" },
            "cheap": { "$ref": "#/definitions/lower" }
          }
        },
        "provenance": { "type": "object" }
      }
    },
    "variants": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/variant" } }
  },
  "definitions": {
    "metricDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "better", "task", "methodologyUrl"],
      "properties": {
        "unit": { "type": "string", "minLength": 1 },
        "better": { "enum": ["higher", "lower"] },
        "task": { "type": "string", "minLength": 1 },
        "methodologyUrl": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "higher": { "allOf": [{ "$ref": "#/definitions/metricDefinition" }, { "properties": { "better": { "const": "higher" } } }] },
    "lower": { "allOf": [{ "$ref": "#/definitions/metricDefinition" }, { "properties": { "better": { "const": "lower" } } }] },
    "sourceOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "benchmarkVersion"],
      "properties": {
        "kind": { "const": "source" },
        "benchmarkVersion": { "type": "string", "minLength": 1 }
      }
    },
    "adjustedOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "benchmarkVersion", "sourceBenchmarkVersion", "method", "factor"],
      "properties": {
        "kind": { "const": "adjusted" },
        "benchmarkVersion": { "type": "string", "minLength": 1 },
        "sourceBenchmarkVersion": { "type": "string", "minLength": 1 },
        "method": { "const": "median-overlap-ratio" },
        "factor": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "creator", "displayName", "checkpoint", "quantization", "metrics", "metricOrigins", "provenance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "creator": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "checkpoint": { "type": ["string", "null"] },
        "quantization": { "type": ["string", "null"] },
        "reasoning": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["label"],
          "properties": { "label": { "type": "string", "minLength": 1 } }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["smart", "fast", "cheap"],
          "properties": {
            "smart": { "type": "number" },
            "fast": { "type": "number", "exclusiveMinimum": 0 },
            "cheap": { "type": "number", "minimum": 0 }
          }
        },
        "metricOrigins": {
          "type": "object",
          "additionalProperties": false,
          "required": ["smart", "fast", "cheap"],
          "properties": {
            "smart": { "$ref": "#/definitions/sourceOrigin" },
            "fast": { "oneOf": [{ "$ref": "#/definitions/sourceOrigin" }, { "$ref": "#/definitions/adjustedOrigin" }] },
            "cheap": { "oneOf": [{ "$ref": "#/definitions/sourceOrigin" }, { "$ref": "#/definitions/adjustedOrigin" }] }
          }
        },
        "provenance": { "type": "object" }
      }
    }
  }
}
