{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Derived rankings without source measurements",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "catalog", "variants", "orders", "dominators"],
  "properties": {
    "kind": { "const": "derived-rankings-v3" },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "generatedAt", "attribution", "termsUrl", "metricDefinitions"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "attribution": { "type": ["string", "null"] },
        "termsUrl": { "type": ["string", "null"], "format": "uri" },
        "metricDefinitions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["smart", "fast", "cheap"],
          "properties": {
            "smart": { "$ref": "#/definitions/metricDefinition" },
            "fast": { "$ref": "#/definitions/metricDefinition" },
            "cheap": { "$ref": "#/definitions/metricDefinition" }
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "creator"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "creator": { "type": "string", "minLength": 1 },
          "reasoning": { "type": "string", "minLength": 1 }
        }
      }
    },
    "subscriptions": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["orders", "dominators"],
        "properties": {
          "orders": { "$ref": "#/properties/orders" },
          "dominators": { "$ref": "#/properties/dominators" }
        }
      }
    },
    "dominators": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "orders": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/indexes" }
    }
  },
  "definitions": {
    "indexes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0 }
    },
    "metricDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "unit", "better", "methodologyUrl"],
      "properties": {
        "task": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "better": { "enum": ["higher", "lower"] },
        "methodologyUrl": { "type": ["string", "null"], "format": "uri" }
      }
    }
  }
}
